{
  // Craft Website: embeddable components for craftpilates.com (Showit).
  // Secrets (wrangler secret put): GOOGLE_SERVICE_ACCOUNT, SHEET_ID.
  "name": "craft-website",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-01",
  "vars": { "SHEET_TAB": "Form Responses 1" },
  // Create with: npx wrangler@4 kv namespace create DATA, then paste its id here.
  "kv_namespaces": [{ "binding": "DATA", "id": "REPLACE_WITH_KV_ID" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
